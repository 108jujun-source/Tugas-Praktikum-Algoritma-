#include <iostream>
#include <string>

using namespace std;

int main() {
    // Deklarasi variabel
    string npm, nama;
    float tugas1, tugas2, tugas3, rataRata;

    // Layar Masukkan
    cout << "PROGRAM HITUNG NILAI RATA-RATA" << endl;
    cout << "NPM         : ";
    cin >> npm;
    // Menggunakan getline untuk menampung nama yang mungkin menggunakan spasi
    cin.ignore(); 
    cout << "Nama        : ";
    getline(cin, nama);
    cout << "Nilai Tugas I   : ";
    cin >> tugas1;
    cout << "Nilai Tugas II  : ";
    cin >> tugas2;
    cout << "Nilai Tugas III : ";
    cin >> tugas3;

    // Menghitung rata-rata nilai tugas
    rataRata = (tugas1 + tugas2 + tugas3) / 3;

    // Layar Keluaran
    cout << "\n----------------------------------------" << endl;
    cout << "NPM " << npm << " Siswa yang bernama " << nama << endl;
    cout << "Memperoleh nilai rata-rata " << rataRata << " dari hasil tugas yang diikutinya." << endl;

    return 0;
}
